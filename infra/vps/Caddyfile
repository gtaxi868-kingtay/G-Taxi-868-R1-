{
  email {$CADDY_EMAIL}
  auto_https disable_redirects
}

{$DOMAIN} {
  encode gzip

  @status path /status
  respond @status 200 {
    body "ok\n"
    close
  }

  # Jarvis is reachable at https://{$DOMAIN}/jarvis/concierge -- set that as
  # JARVIS_SERVICE_URL in Supabase edge function secrets once this domain is
  # live. strip_prefix so Jarvis itself only ever sees /concierge, /health.
  handle_path /jarvis/* {
    reverse_proxy jarvis:8000
  }

  # Optional blue/green HTTP service. This is for services hosted on this VPS;
  # Supabase Edge Functions remain managed by Supabase and use the promotion
  # workflows under .github/workflows/.
  @service path /ops/*
  handle @service {
    uri strip_prefix /ops
    reverse_proxy {$BLUE_UPSTREAM} {$GREEN_UPSTREAM} {
      lb_policy first
      health_uri /ready
      health_interval 10s
      health_timeout 3s
      fail_duration 30s
      max_fails 2
    }
  }

  handle {
    reverse_proxy uptime-kuma:3001
  }
}

localhost {
  encode gzip

  @service path /ops/*
  handle @service {
    uri strip_prefix /ops
    reverse_proxy {$BLUE_UPSTREAM} {$GREEN_UPSTREAM} {
      lb_policy first
      health_uri /ready
      health_interval 10s
      health_timeout 3s
      fail_duration 30s
      max_fails 2
    }
  }

  handle {
    reverse_proxy uptime-kuma:3001
  }
}
