# Copy this file to .env and fill in your real values.
DOMAIN=localhost
CADDY_EMAIL=admin@example.com

# Optional, for worker tasks and future queueing.
REDIS_URL=redis://redis:6379/0
WORKER_TICK_SECONDS=60

# Keep these empty until you actually use a real external worker.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Jarvis (rider AI concierge, services/jarvis). JARVIS_SECRET must match the
# JARVIS_SECRET Supabase edge function secret exactly -- it's the shared
# secret ai_concierge_proactive sends as X-Jarvis-Secret so Jarvis can trust
# the caller. GROQ_API_KEY is Jarvis's own key, separate from any key the
# Supabase edge functions use (Jarvis calls Groq directly, outside
# _shared/llm.ts's budget cap -- a known gap, not this file's job to fix).
JARVIS_SECRET=
GROQ_API_KEY=
