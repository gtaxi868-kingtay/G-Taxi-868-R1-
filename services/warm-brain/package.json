{
  "name": "g-taxi-warm-brain",
  "version": "1.0.0",
  "description": "Persistent Railway Node.js server with Redis for wallet cache, geofencing, and driver matching. Supabase edge functions hand off latency-sensitive ops here.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "docker:build": "docker build -t g-taxi-warm-brain .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ioredis": "^5.4.1",
    "@supabase/supabase-js": "^2.45.0",
    "express": "^4.21.0",
    "ws": "^8.18.0",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "tsx": "^4.19.0",
    "@types/express": "^4.17.21",
    "@types/ws": "^8.5.12",
    "@types/node": "^22.0.0"
  }
}
