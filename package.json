    "dev:admin": "npm --workspace apps/admin run start",
    "dev:merchant": "npm --workspace apps/merchant run start",
    "dev": "npm run dev:rider"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "dependency-cruiser": "^17.4.0"
  }
}
