{
  "name": "g-taxi-rider",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "npm@10.9.4",
  "scripts": {
    "dev:rider": "npm --workspace apps/rider run start",
    "dev:driver": "npm --workspace apps/driver run start",
    "dev:admin": "npm --workspace apps/admin run dev",
    "dev:merchant": "npm --workspace apps/merchant run dev",
    "dev": "npm run dev:rider",
    "build": "npm run build:admin && npm run build:merchant",
    "build:admin": "npm --workspace apps/admin run build",
    "build:merchant": "npm --workspace apps/merchant run build",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "orphans": "knip",
    "orphans:files": "knip --include files",
    "lint:strict": "npm run lint && npm run typecheck",
    "typecheck": "npm --workspace apps/rider run typecheck && npm --workspace apps/driver run typecheck && npm --workspace apps/admin run typecheck && npm --workspace apps/merchant run typecheck && npm --workspace apps/merchant-mobile run typecheck && npm --workspace apps/admin-mobile run typecheck",
    "test": "npm --workspace apps/rider run test && npm --workspace apps/driver run test && npm --workspace apps/admin run test && npm --workspace apps/merchant run test && npm --workspace apps/merchant-mobile run test && npm --workspace apps/admin-mobile run test",
    "turbo:build": "npx turbo run build",
    "format": "prettier --write \"apps/**/*.{ts,tsx,js,jsx}\" \"packages/**/*.{ts,tsx,js,jsx}\" \"supabase/functions/**/*.ts\"",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,js,jsx}\" \"packages/**/*.{ts,tsx,js,jsx}\" \"supabase/functions/**/*.ts\"",
    "verify:all": "node scripts/verify-all.js",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "expo": "~52.0.49",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.9",
    "vite": "^7.3.5"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "ajv": "^8.20.0",
    "dependency-cruiser": "^17.4.0",
    "eslint": "^9.0.0",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-import-resolver-typescript": "^3.6.0",
    "eslint-plugin-import": "^2.32.0",
    "knip": "^5.88.1",
    "prettier": "^3.8.3",
    "syncpack": "^15.3.1",
    "turbo": "^2.9.16"
  },
  "overrides": {
    "expo-task-manager": "12.0.6",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.9",
    "react-test-renderer": "18.3.1",
    "@supabase/supabase-js": "2.108.2",
    "nanoid": "3.3.18",
    "postcss": "8.5.25"
  },
  "type": "module",
  "version": "1.0.0"
}
