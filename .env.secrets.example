# Copy to .env.secrets and replace placeholder values with your real secrets.
# NEVER commit real secrets to git. This file is a template only.

# Supabase (get from Project → Settings → API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJ... (public anon key)
# Service role key MUST be set only in Edge Function environment variables (Dashboard)
SUPABASE_SERVICE_ROLE_KEY=KEY-... (service role)

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Firebase (base64 JSON string)
FIREBASE_SERVICE_ACCOUNT_JSON="{...}"

# WiPay
WIPAY_API_KEY=...
WIPAY_WEBHOOK_SECRET=...
WIPAY_ACCOUNT_NUMBER=1234567890
WIPAY_API_URL=https://tt.wipayfinancial.com/plugins/payments/request

# Amadeus / Booking.com
AMADEUS_API_KEY=...
AMADEUS_API_SECRET=...
BOOKING_API_KEY=...
BOOKING_PARTNER_ID=...

# Redis (Upstash)
UPSTASH_REDIS_REST_URL=https://us...q.upstash.io
UPSTASH_REDIS_REST_TOKEN=...

# Sentry
SENTRY_DSN=https://publicKey@o0.ingest.sentry.io/0

# WhatsApp Cloud
WHATSAPP_PHONE_NUMBER_ID=...
WHATSAPP_ACCESS_TOKEN=...

# NOTE: For non-engineers, set the above in Supabase Dashboard instead of using the CLI.
# Dashboard path: Project → Edge Functions → Settings → Environment Variables
# After setting, redeploy or refresh functions and check Edge Functions logs for errors.
